{
  "manifest_version": 3,
  "name": "Claude Pixel Background",
  "version": "1.0.0",
  "description": "Animated pixel-art backgrounds for claude.ai. Pick from 9 scenes.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["pixel-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Pixel BG",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
